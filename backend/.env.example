PORT=8081
WEB_ORIGINS=http://localhost:5173
PUBLIC_APPROVED_PHOTOS_BUCKET=nombre-del-bucket-publico-solo-fotos-aprobadas
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/credenciales-servidor.json (solo fuera de Cloud Run)

# Correo: configurar SOLO en servidor, nunca exponer la contraseña a Vite/frontend.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=notificaciones@tudominio.com.py
SMTP_PASS=CONTRASENA_DE_APLICACION_EN_SERVIDOR
SMTP_FROM="Nde Rogarã <notificaciones@tudominio.com.py>"

# Panel SMTP privado: clave aleatoria de 32 bytes en hexadecimal.
# Generar en servidor con: openssl rand -hex 32
# No subir la clave ni la contraseña real a GitHub.
MAIL_ENCRYPTION_KEY=REEMPLAZAR_POR_64_CARACTERES_HEXADECIMALES
# Firestore debe estar habilitado en el proyecto Firebase del backend.
