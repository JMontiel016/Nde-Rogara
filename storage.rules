rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Solo cuenta autenticada puede subir/modificar su propio material.
    // Las fotos/videos se revisan antes de publicar un anuncio.
    match /property-media/{userId}/{kind}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (
          (kind == 'image' && request.resource.size <= 50 * 1024 * 1024
             && request.resource.contentType.matches('image/(jpeg|png|webp)'))
          ||
          (kind == 'video' && request.resource.size <= 100 * 1024 * 1024
             && request.resource.contentType.matches('video/(mp4|webm|quicktime)'))
        );
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }
  }
}
